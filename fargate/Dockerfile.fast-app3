# Fast Dockerfile for app3.py using pre-compiled wheels
FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PORT=8080
ENV FLASK_APP=app3.py
ENV ENVIRONMENT=production

# Install system dependencies (minimal)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get autoremove -y \
    && apt-get autoclean

# Create working directory and user
WORKDIR /app
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app

# Install Python packages using pre-compiled wheels (much faster)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --only-binary=all \
    numpy==1.24.3 \
    polars==0.20.2 \
    scipy==1.10.1 \
    boto3==1.34.34 \
    flask==2.3.3 \
    gunicorn==21.2.0

# Copy application
COPY --chown=appuser:appuser app3.py .

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Run with gunicorn
CMD ["gunicorn", "--bind", "0.0.0.0:8080", "--workers", "1", "--threads", "4", "--timeout", "60", "--preload", "app3:app"]